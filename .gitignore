# Go
/logparseapp
/api
*.exe
*.test
*.out

# Node / Next.js (web/.gitignore covers these too; repeated here so a stray
# install at the repo root cannot sneak into a commit)
node_modules/
.next/
out/
build/
.env*.local

# Agent tooling -- not needed to build or run the app.
# web/AGENTS.md and web/CLAUDE.md are regenerated by `next dev`, so they are
# ignored rather than deleted; they will reappear locally and stay out of git.
.claude/
web/AGENTS.md
web/CLAUDE.md

# Editor / OS
.DS_Store
*.pem
*.swp
.idea/
.vscode/
