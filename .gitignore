# Go -- compiled binaries land next to the source in server/
/server/server
/server/logparseapp
/logparseapp
*.exe
*.test
*.out

# Node / Next.js (client/.gitignore covers these too; repeated here so a stray
# install at the repo root cannot sneak into a commit)
node_modules/
.next/
out/
build/
.env*.local

# Agent tooling -- not needed to build or run the app.
# client/AGENTS.md and client/CLAUDE.md are regenerated by `next dev`, so they
# are ignored rather than deleted; they reappear locally and stay out of git.
.claude/
client/AGENTS.md
client/CLAUDE.md

# Editor / OS
.DS_Store
*.pem
*.swp
.idea/
.vscode/
